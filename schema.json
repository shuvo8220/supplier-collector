      {
       "key": "custom_details",
       "label": "Custom Details (if Yes) / কাস্টম বিস্তারিত",
       "type": "textarea",
       "placeholder": "যদি Yes হয়, তাহলে কি কি custom size/print করতে পারেন বিস্তারিত লিখুন",
       "conditional": "custom",
       "showWhen": "Yes"
      },
      {
       "key": "sample",
       "label": "Sample available?",
       "type": "radio",
       "options": [
        "Yes",
        "No"
       ]
      },
      {
       "key": "sample_details",
       "label": "Sample Details (if Yes) / স্যাম্পল বিস্তারিত",
       "type": "text",
       "placeholder": "কত দিনে sample পাওয়া যাবে? খরচ কত?",
       "conditional": "sample",
       "showWhen": "Yes"
      }
     ]
    },
    {
     "title": "Commercial / ব্যবসায়িক তথ্য",
     "fields": [
      {
       "key": "moq",
       "label": "MOQ / সর্বনিম্ন অর্ডার",
