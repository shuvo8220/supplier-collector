       "placeholder": "Days"
      },
      {
       "key": "price_list",
       "label": "Price list available?",
       "type": "radio",
       "options": [
        "Yes",
        "No"
       ]
      },
      {
       "key": "price_list_details",
       "label": "Price List Details (if Yes) / প্রাইস লিস্ট বিস্তারিত",
       "type": "text",
       "placeholder": "Price list কোথায় পাওয়া যাবে? (Email, Website, etc.)",
       "conditional": "price_list",
       "showWhen": "Yes"
